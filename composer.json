{
  "name": "roots/wp-config",
  "description": "Fluent configuration management for WordPress",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "roots.io",
      "email": "team@roots.io"
    }
  ],
  "autoload": {
    "psr-4": {
      "Roots\\WPConfig\\": "src"
    }
  },
  "require": {
    "php": ">=8.3",
    "vlucas/phpdotenv": "^5.0"
  },
  "scripts": {
    "format": "mago format --check",
    "format:fix": "mago format",
    "lint": "mago lint",
    "test": "pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "carthage-software/mago": "^1.0",
    "pestphp/pest": "^4.0"
  }
}
